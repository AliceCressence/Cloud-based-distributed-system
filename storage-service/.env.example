# Database
DATABASE_URL=postgresql://storage_user:storage_pass@localhost:5432/ictnexus_storage

# JWT (shared with auth-service)
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Storage Configuration
CHUNK_SIZE_MB=2
DEFAULT_STUDENT_QUOTA_GB=2
DEFAULT_GRAD_QUOTA_GB=5
DEFAULT_FACULTY_QUOTA_GB=10
REPLICATION_FACTOR=2
STORAGE_NODES=localhost:50051,localhost:50052,localhost:50053

# Service URLs
AUTH_SERVICE_URL=http://localhost:5000
STUDENT_SERVICE_URL=http://localhost:5001
COURSE_SERVICE_URL=http://localhost:5002

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
